# ── Required ──────────────────────────────────────────────────────────────────

TELEGRAM_TOKEN=
OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
SUPABASE_URL=

# Server-side key — used by bot.py and content_engine.py. Bypasses RLS, so
# keep this secret and NEVER ship it to any client (web, mobile, Lovable).
SUPABASE_SERVICE_ROLE_KEY=

# Public anon key — used only by the admin dashboard (Lovable) and any
# browser code. Also serves as fallback for local dev.
SUPABASE_ANON_KEY=

# ── Optional (defaults shown) ─────────────────────────────────────────────────

CLAUDE_MODEL=anthropic/claude-sonnet-4-6
SEARCH_MODEL=perplexity/sonar-pro

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# If set, bot.py sends this as `x-webhook-secret` when calling
# webhook-post-approved, so the edge function can verify the call originated
# from our worker. Leave blank to skip verification.
WEBHOOK_SECRET=

# Shown to the founder after APPROVE (Lovable admin dashboard URL).
ADMIN_DASHBOARD_URL=

# content_engine.py — concurrent founders to process in parallel (default 5).
FOUNDER_CONCURRENCY=5

WELCOME_GIF=
